package com.manny.orders;

import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;

import redis.clients.jedis.Jedis;
import com.rabbitmq.client.AMQP;
import com.rabbitmq.client.Channel;
import com.rabbitmq.client.ConnectionFactory;

import java.io.IOException;
import java.io.PrintWriter;
import java.lang.management.ManagementFactory;
import java.lang.management.MemoryUsage;
import java.net.URLEncoder;
import java.nio.charset.StandardCharsets;
import java.sql.*;
import java.time.Duration;
import java.time.Instant;

@WebServlet("/observability")
public class ObservabilityServlet extends HttpServlet {

    private String esc(String v) {
        if (v == null) return "";
        return v.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;");
    }

    private String money(java.math.BigDecimal v) {
        return v == null ? "—" : "$" + v.toPlainString();
    }

    private String liveHealth(String lifecycle, Timestamp lastSeen) {
        if (!"ACTIVE".equalsIgnoreCase(lifecycle)) return "NOT ACTIVE";
        if (lastSeen == null) return "STALE";
        return Duration.between(lastSeen.toInstant(), Instant.now()).getSeconds() <= 120
                ? "HEALTHY" : "STALE";
    }

    private String lc(String v) {
        if ("ACTIVE".equalsIgnoreCase(v)) return "life-active";
        if ("ABANDONED_ON_RESTART".equalsIgnoreCase(v)) return "life-restart";
        return "life-ended";
    }

    private String hc(String v) {
        if ("HEALTHY".equals(v)) return "health-good";
        if ("STALE".equals(v)) return "health-stale";
        return "health-off";
    }

    private void metric(PrintWriter out,String icon,String title,String value,String detail,boolean good) {
        out.println("<div class='metric'><div class='metric-icon'>" + icon + "</div><div class='metric-title'>" +
                esc(title) + "</div><div class='metric-value " + (good ? "good" : "bad") + "'>" +
                esc(value) + "</div><div class='metric-detail'>" + esc(detail) + "</div></div>");
    }

    @Override
    protected void doGet(HttpServletRequest req,HttpServletResponse resp) throws IOException {

        resp.setContentType("text/html;charset=UTF-8");
        PrintWriter out = resp.getWriter();
        String ctx = req.getContextPath();

        int dbUp=0,backendPid=0;
        long liveSessions=0,allSessions=0,requests=0,http5xx=0;
        double avgMs=0;

        try (Connection c=Db.getConnection(); Statement st=c.createStatement();
             ResultSet rs=st.executeQuery("""
                 SELECT pg_backend_pid(),
                   (SELECT COUNT(*) FROM app_sessions WHERE status='ACTIVE'
                      AND last_seen_at > CURRENT_TIMESTAMP - INTERVAL '2 minutes'),
                   (SELECT COUNT(*) FROM app_sessions),
                   (SELECT COUNT(*) FROM app_request_history),
                   (SELECT COUNT(*) FROM app_request_history WHERE http_status>=500),
                   COALESCE((SELECT AVG(duration_ms) FROM app_request_history),0)
                 """)) {
            rs.next(); dbUp=1; backendPid=rs.getInt(1); liveSessions=rs.getLong(2);
            allSessions=rs.getLong(3); requests=rs.getLong(4); http5xx=rs.getLong(5); avgMs=rs.getDouble(6);
        } catch(Exception ignored){}

        int redisUp=0; long redisKeys=0;
        try(Jedis j=new Jedis("localhost",6379)){redisUp="PONG".equalsIgnoreCase(j.ping())?1:0;redisKeys=j.dbSize();}catch(Exception ignored){}

        int rabbitUp=0; long rabbitReady=0,rabbitConsumers=0;
        try{
            ConnectionFactory f=new ConnectionFactory();f.setHost("localhost");f.setUsername("guest");f.setPassword("guest");
            try(com.rabbitmq.client.Connection c=f.newConnection();Channel ch=c.createChannel()){
                AMQP.Queue.DeclareOk q=ch.queueDeclarePassive("orders.events");
                rabbitReady=q.getMessageCount();rabbitConsumers=q.getConsumerCount();rabbitUp=1;
            }
        }catch(Exception ignored){}

        int threads=ManagementFactory.getThreadMXBean().getThreadCount();
        MemoryUsage heap=ManagementFactory.getMemoryMXBean().getHeapMemoryUsage();
        long heapUsed=heap.getUsed()/1024/1024, heapMax=heap.getMax()/1024/1024;
        long upSec=ManagementFactory.getRuntimeMXBean().getUptime()/1000;
        boolean appHealthy=dbUp==1&&redisUp==1&&rabbitUp==1&&http5xx==0;

        out.println("""
