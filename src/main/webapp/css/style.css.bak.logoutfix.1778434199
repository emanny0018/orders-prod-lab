body {
    margin: 0;
    font-family: Arial, sans-serif;

    background-image: url("../images/office-bg.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

/* DARK OVERLAY */
.bg-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 0;
}

/* CONTENT */
.hero-shell {
    position: relative;
    z-index: 1;
    text-align: center;
    color: white;
    top: 40%;
}

/* BUTTON */
.btn {
    padding: 10px 20px;
    background: white;
    color: black;
    text-decoration: none;
    border-radius: 5px;
}

/* MARQUEE */
.marquee-text {
    animation: scroll 10s linear infinite;
    white-space: nowrap;
}

@keyframes scroll {
    from { transform: translateX(100%); }
    to { transform: translateX(-100%); }
}

/* ===== ERICMANNY POS LAB UI UPGRADE ===== */

body {
  background:
    linear-gradient(rgba(2, 6, 23, 0.72), rgba(2, 6, 23, 0.82)),
    url("https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1800&q=80") center center / cover fixed !important;
}

.sidebar {
  overflow-y: auto !important;
  max-height: 100vh !important;
  background: rgba(2, 6, 23, 0.92) !important;
  backdrop-filter: blur(12px);
  border-right: 1px solid rgba(148, 163, 184, 0.18);
}

.sidebar a {
  display: block;
  padding: 12px 20px;
  margin: 6px 12px;
  border-radius: 12px;
  color: #e5e7eb !important;
  text-decoration: none;
  font-weight: 700;
  transition: all .2s ease;
}

.sidebar a:hover {
  background: linear-gradient(90deg, #2563eb, #7c3aed);
  color: white !important;
  transform: translateX(3px);
}

.section-label,
.sidebar .section-label {
  color: #94a3b8 !important;
  font-size: 12px;
  letter-spacing: .12em;
  font-weight: 900;
  margin: 22px 20px 8px 20px;
}

.content,
.main,
.main-content {
  background: rgba(15, 23, 42, 0.54) !important;
  backdrop-filter: blur(5px);
}

.hero,
.banner {
  background:
    linear-gradient(90deg, rgba(37,99,235,.92), rgba(124,58,237,.88)),
    url("https://images.unsplash.com/photo-1556742502-ec7c0e9f34b1?auto=format&fit=crop&w=1600&q=80") center center / cover !important;
  border-radius: 24px !important;
  box-shadow: 0 24px 60px rgba(0,0,0,.28);
}

.card,
.table-card,
.lab-card,
.heap-card,
.lab-section,
.heap-section {
  border-radius: 22px !important;
  box-shadow: 0 18px 45px rgba(0,0,0,.20) !important;
}

button,
.lab-btn,
.heap-btn {
  border-radius: 12px !important;
  box-shadow: 0 10px 22px rgba(0,0,0,.14);
}

input,
.lab-input,
.heap-input {
  border-radius: 12px !important;
}

/* Make the sidebar usable on smaller screens */
@media (max-height: 820px) {
  .sidebar a {
    padding: 9px 18px;
    margin: 4px 10px;
    font-size: 14px;
  }

  .section-label,
  .sidebar .section-label {
    margin-top: 14px;
  }
}

/* force full sidebar scroll and compact menu */
.sidebar {
  height: 100vh !important;
  max-height: 100vh !important;
  overflow-y: auto !important;
  padding-bottom: 80px !important;
}

.sidebar a {
  padding: 8px 18px !important;
  margin: 3px 10px !important;
  font-size: 14px !important;
}

.section-label,
.sidebar .section-label {
  margin: 12px 20px 6px 20px !important;
  font-size: 11px !important;
}
